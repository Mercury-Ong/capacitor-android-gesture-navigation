{
  "name": "capacitor-android-gesture-navigation",
  "version": "0.1.0",
  "description": "Capacitor plugin for Android: detects gesture vs button navigation and keeps the status and navigation bar icons readable by sampling what is on screen.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/"
  ],
  "author": "Mercury Ong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mercury-Ong/capacitor-android-gesture-navigation.git"
  },
  "bugs": {
    "url": "https://github.com/Mercury-Ong/capacitor-android-gesture-navigation/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "android",
    "navigation bar",
    "gesture navigation",
    "status bar",
    "edge-to-edge"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/core": "^8.4.3",
    "typescript": "~5.6.2"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}
